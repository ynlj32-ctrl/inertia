		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self:_order(),
	}, self.Container)
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, wrap)
	create("UIPadding", { PaddingLeft = UDim.new(0, 15), PaddingRight = UDim.new(0, 15) }, wrap)
	local head = create("TextButton", { BackgroundColor3 = C.Header, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 16), Text = "", AutoButtonColor = false, LayoutOrder = 1 }, wrap)
	create("UIStroke", { Color = Color3.fromRGB(28, 28, 28), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, head)
	text(head, name, { Position = UDim2.fromOffset(7, 0), Size = UDim2.new(1, -24, 1, 0), TextColor3 = C.Text })
	local arrow = text(head, "^", { Position = UDim2.new(1, -18, 0, 0), Size = UDim2.fromOffset(12, 16), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Text })
	local body = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, wrap)
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)
