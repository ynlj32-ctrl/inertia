--// scroll container ---------------------------------------------------------
local function makeScroll(parent, pos, size)
	local sf = create("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = pos, Size = size, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ScrollingDirection = Enum.ScrollingDirection.Y,
		TopImage = "rbxasset://textures/ui/Scroll/scroll-middle.png", MidImage = "rbxasset://textures/ui/Scroll/scroll-middle.png",
		BottomImage = "rbxasset://textures/ui/Scroll/scroll-middle.png",
	}, parent)
	accent(sf, "ScrollBarImageColor3")
	local layout = create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
	create("UIPadding", { PaddingLeft = UDim.new(0, 15), PaddingRight = UDim.new(0, 15), PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }, sf)
	return sf, layout
end

--// columns / groupboxes / tabboxes ------------------------------------------
local Column = {}
Column.__index = Column

function Column:Relayout()
	-- Groupboxes always fill the column (like the reference): each gets its content height, but never less
	-- than an equal share of the column; whatever is left over goes to the last box. Overflow scrolls inside.
	local GAP = 8
	local n = #self.Groups
	if n == 0 then return end
	local avail = Library._colH - GAP * (n - 1)
	local share = math.floor(avail / n)
	local heights, total = {}, 0
	for i, g in ipairs(self.Groups) do
		heights[i] = math.min(g:GetHeight(), share)
		total += heights[i]
	end
	local leftover = avail - total
	for i, g in ipairs(self.Groups) do
		local extra = math.min(g:GetHeight() - heights[i], leftover)
		if extra > 0 then heights[i] += extra; leftover -= extra end
	end
	heights[n] += leftover
	local used = 0
	for i, g in ipairs(self.Groups) do
		g.Frame.Position = UDim2.fromOffset(0, used)
		g.Frame.Size = UDim2.new(1, 0, 0, heights[i])
		used += heights[i] + GAP
	end
end

function Column:AddGroupbox(name)
	local gb = setmetatable({ Gui = Library.Gui, Options = Library.Options }, Base)
	local f = box(self.Frame, { BackgroundColor3 = C.Panel }, C.Border)
	text(f, name, { Position = UDim2.fromOffset(6, 0), Size = UDim2.new(1, -12, 0, 20), TextColor3 = C.TextDim })
	local sf, layout = makeScroll(f, UDim2.fromOffset(0, 20), UDim2.new(1, 0, 1, -22))
	gb.Frame, gb.Container = f, sf
	function gb:GetHeight() return layout.AbsoluteContentSize.Y + 12 + 8 + 22 end
	connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function() self:Relayout() end)
	table.insert(self.Groups, gb)
	self:Relayout()
	return gb
end

function Column:AddTabbox()
	local tb = { Tabs = {}, Gui = Library.Gui }
	local f = box(self.Frame, { BackgroundColor3 = C.Panel }, C.Border)
	local head = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20) }, f)
	box(f, { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.Border })
	tb.Frame = f
	local col = self
	function tb:GetHeight()
		local cur = self.Current
		return (cur and cur.Layout.AbsoluteContentSize.Y or 0) + 12 + 8 + 24
	end
	function tb:Select(tab)
		self.Current = tab
		for _, t in ipairs(self.Tabs) do
			local on = t == tab
			t.Scroll.Visible = on
			t.Button.TextColor3 = on and Library.Accent or C.TextDim
			t.Line.Visible = on
		end
		col:Relayout()
	end
	function tb:AddTab(name)
		local tab = setmetatable({ Gui = Library.Gui, Options = Library.Options }, Base)
		local sf, layout = makeScroll(f, UDim2.fromOffset(0, 22), UDim2.new(1, 0, 1, -24))
		sf.Visible = false
		tab.Scroll, tab.Layout, tab.Container = sf, layout, sf
		tab.Button = create("TextButton", {
			BackgroundTransparency = 1, Text = name, Font = Library.Font, TextSize = Library.TextSize, TextColor3 = C.TextDim,
			Size = UDim2.fromScale(1, 1), AutoButtonColor = false,
		}, head)
		tab.Line = box(tab.Button, { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Library.Accent, Visible = false })
		accent(tab.Line, "BackgroundColor3")
		table.insert(self.Tabs, tab)
		local n = #self.Tabs
		for i, t in ipairs(self.Tabs) do
			t.Button.Size = UDim2.new(1 / n, 0, 1, 0)
			t.Button.Position = UDim2.new((i - 1) / n, 0, 0, 0)
		end
		connect(tab.Button.MouseButton1Click, function() self:Select(tab) end)
		connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function() col:Relayout() end)
		if n == 1 then self:Select(tab) end
		return tab
	end
	table.insert(self.Groups, tb)
	self:Relayout()
	return tb
end

local function newColumn(parent, side)
	local col = setmetatable({ Groups = {} }, Column)
	col.Frame = create("Frame", {
		BackgroundTransparency = 1,
		Position = side == "Left" and UDim2.new() or UDim2.new(0.5, 6, 0, 0),
		Size = UDim2.new(0.5, -6, 1, 0),
	}, parent)
	return col
end

--// page API (shared by Tab and SubTab) --------------------------------------
local PageAPI = {}
PageAPI.__index = PageAPI
function PageAPI:AddLeftGroupbox(n) return self:_GetPage().Left:AddGroupbox(n) end
function PageAPI:AddRightGroupbox(n) return self:_GetPage().Right:AddGroupbox(n) end
function PageAPI:AddLeftTabbox() return self:_GetPage().Left:AddTabbox() end
function PageAPI:AddRightTabbox() return self:_GetPage().Right:AddTabbox() end

local TabAPI = setmetatable({}, { __index = PageAPI })
TabAPI.__index = TabAPI
local SubAPI = setmetatable({}, { __index = PageAPI })
SubAPI.__index = SubAPI

function SubAPI:_GetPage() return self.Page end
function TabAPI:_GetPage()
	if not self.Default then
		self.Default = self:_NewPage()
		self.Default.Content.Visible = not self.HasSide
	end
	return self.Default
end

function TabAPI:_Layout()
	for _, p in ipairs(self.Pages) do
		if self.HasSide then
			p.Content.Position = UDim2.fromOffset(112, 0)
			p.Content.Size = UDim2.new(1, -121, 1, 0)
		else
			p.Content.Position = UDim2.fromOffset(9, 0)
			p.Content.Size = UDim2.new(1, -18, 1, 0)
		end
	end
end

function TabAPI:_NewPage()
	local content = create("Frame", { BackgroundTransparency = 1, Visible = false }, self.Root)
	local page = { Content = content, Left = newColumn(content, "Left"), Right = newColumn(content, "Right") }
	table.insert(self.Pages, page)
	self:_Layout()
	return page
end

function TabAPI:SelectSubTab(sub)
	self.CurrentSub = sub
	for _, s in ipairs(self.Subs) do
		local on = s == sub
		s.Page.Content.Visible = on
		s.Button.TextColor3 = on and Library.Accent or C.TextDim
		s.Button.BackgroundTransparency = 1
		s.Bar.Visible = on
	end
end

function TabAPI:AddSubTab(name)
	self.HasSide = true
	self.Sidebar.Visible = true
	if self.Default then self.Default.Content.Visible = false end
	local sub = setmetatable({ Tab = self, Page = self:_NewPage() }, SubAPI)
	sub.Button = create("TextButton", {
		BackgroundColor3 = Color3.fromRGB(19, 19, 19), BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 20),
		Text = name, Font = Library.Font, TextSize = Library.TextSize, TextColor3 = C.TextDim, TextXAlignment = Enum.TextXAlignment.Left,
		AutoButtonColor = false, LayoutOrder = #self.Subs + 1,
	}, self.Sidebar)
	create("UIPadding", { PaddingLeft = UDim.new(0, 10) }, sub.Button)
	sub.Bar = box(sub.Button, { Position = UDim2.fromOffset(-10, 0), Size = UDim2.fromOffset(1, 20), BackgroundColor3 = Library.Accent, Visible = false })
	accent(sub.Bar, "BackgroundColor3")
	table.insert(self.Subs, sub)
	connect(sub.Button.MouseButton1Click, function() self:SelectSubTab(sub) end)
	self:_Layout()
	if #self.Subs == 1 then self:SelectSubTab(sub) end
	return sub
end

--// window -------------------------------------------------------------------
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local parent = (gethui and gethui()) or Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = create("ScreenGui", { Name = "LinoriaStyleUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 1000 }, parent)
	self.Gui = gui

	local size = cfg.Size or UDim2.fromOffset(580, 400)
	self._colH = size.Y.Offset - 69

	local main = box(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = cfg.Center == false and UDim2.fromOffset(340, 260) or UDim2.fromScale(0.5, 0.5),
		Size = size, BackgroundColor3 = C.Window, Visible = cfg.AutoShow ~= false,
	}, C.Border)
	self.Main = main
	self.Modal = create("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.new(), Modal = main.Visible }, main)

	self.NotifyHolder = create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 40), Size = UDim2.fromOffset(300, 400) }, gui)
	create("UIListLayout", { Padding = UDim.new(0, 5) }, self.NotifyHolder)

	local Window = {}

	-- drag
	local top = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 23) }, main)
	do
		local start, origin, dragging
		connect(top.InputBegan, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging, start, origin = true, mouse(), main.Position
				self:_closePopup()
			end
		end)
		connect(UserInputService.InputChanged, function(i)
			if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
				local d = mouse() - start
				main.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
			end
		end)
		connect(UserInputService.InputEnded, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
		end)
	end

	-- title, underline, tab row
	local title = cfg.Title or "name"
	local tl = text(main, title, { Position = UDim2.fromOffset(7, 4), Size = UDim2.fromOffset(measure(title) + 4, 16) })
	accent(tl, "TextColor3")

	local underline = box(main, { Position = UDim2.fromOffset(0, 23), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = self.Accent })
	accent(underline, "BackgroundColor3")
	create("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.8, 0.1), NumberSequenceKeypoint.new(1, 1),
	}) }, underline)

	local tabHolder = create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(math.max(102, measure(title) + 24), 3), Size = UDim2.new(1, -110, 0, 21) }, main)
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, tabHolder)

	local pages = create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 33), Size = UDim2.new(1, 0, 0, self._colH) }, main)

	local tabs, current = {}, nil
	function Window:SelectTab(tab)
		if current then
			current.Root.Visible = false
			current.Button.TextColor3 = C.TextDim
			for _, l in ipairs(current.Lines) do l.Visible = false end
		end
		current = tab
		tab.Root.Visible = true
		tab.Button.TextColor3 = Library.Accent
		for _, l in ipairs(tab.Lines) do l.Visible = true end
		Library:_closePopup()
	end

	function Window:AddTab(name)
		local tab = setmetatable({ Name = name, HasSide = false, Subs = {}, Pages = {}, Lines = {} }, TabAPI)
		local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(measure(name) + 16, 21), LayoutOrder = #tabs + 1 }, tabHolder)
		for _, g in ipairs({
			{ UDim2.new(), UDim2.new(1, 0, 0, 1) },
			{ UDim2.new(), UDim2.new(0, 1, 1, 0) },
			{ UDim2.new(1, -1, 0, 0), UDim2.new(0, 1, 1, 0) },
		}) do
			local l = box(holder, { Position = g[1], Size = g[2], BackgroundColor3 = Library.Accent, Visible = false })
			accent(l, "BackgroundColor3")
			table.insert(tab.Lines, l)
		end
		tab.Button = create("TextButton", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = name, Font = Library.Font, TextSize = Library.TextSize,
			TextColor3 = C.TextDim, AutoButtonColor = false,
		}, holder)

		tab.Root = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, pages)
		tab.Sidebar = box(tab.Root, { Position = UDim2.fromOffset(9, 0), Size = UDim2.new(0, 94, 1, 0), BackgroundColor3 = C.Panel, Visible = false }, C.Border)
		create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, tab.Sidebar)
		create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 0) }, tab.Sidebar)

		connect(tab.Button.MouseButton1Click, function() Window:SelectTab(tab) end)
		table.insert(tabs, tab)
		if #tabs == 1 then Window:SelectTab(tab) end
		return tab
	end

	-- global input: menu key + click-away for popups
	connect(UserInputService.InputBegan, function(i, gp)
		-- gp is true when the click lands on a GUI button (dropdown items, swatches, ...), so only
		-- treat clicks on empty space as "click away"
		if i.UserInputType == Enum.UserInputType.MouseButton1 and not gp then
			local p = self._popup
			if p then
				local m = mouse()
				if not inside(p.Frame, m) and not inside(p.Opener, m) then self:_closePopup() end
			end
		end
		if gp then return end
		local tk = self.ToggleKeybind
		if tk then
			local hit
			if typeof(tk) == "EnumItem" then hit = i.KeyCode == tk
			elseif type(tk) == "table" then hit = keyName(i) == tk.Value
			elseif type(tk) == "string" then hit = keyName(i) == tk end
			if hit then self:Toggle() end
		end
	end)

	return Window
end

return Library
