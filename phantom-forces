	-- Trajectory Solver

	local function solve(a, b, c, d, e)
		if not a then
			return
		elseif a > -1e-10 and a < 1e-10 then
			return solve(b, c, d, e)
		else
			if e then
				local p = -b / (4 * a)
				local q = (c + p * (3 * b + 6 * a * p)) / a
				local r = (d + p * (2 * c + p * (3 * b + 4 * a * p))) / a
				local s = (e + p * (d + p * (c + p * (b + a * p)))) / a
				if r > -1e-10 and r < 1e-10 then
					local r1, r2 = solve(1, q, s)
					if not r2 or r2 < 0 then return end
					local sq1 = math.sqrt(r1)
					local sq2 = math.sqrt(r2)
					return p - sq2, p - sq1, p + sq1, p + sq2
				else
					local v1, _, v3 = solve(1, 2 * q, q * q - 4 * s, -r * r)
					local v = v3 or v1
					local sv = math.sqrt(v)
					local a1, a2 = solve(1, sv, (v + q - r / sv) / 2)
					local b1, b2 = solve(1, -sv, (v + q + r / sv) / 2)
					if a1 and b1 then return p + a1, p + a2, p + b1, p + b2
					elseif a1 then return p + a1, p + a2
					elseif b1 then return p + b1, p + b2 end
				end
			elseif d then
				local p = -b / (3 * a)
				local q = -(c + p * (2 * b + 3 * a * p)) / (3 * a)
				local r = -(d + p * (c + p * (b + a * p))) / (2 * a)
				local disc = r * r - q * q * q
				local sd = math.sqrt(math.abs(disc))
				if disc > 0 then
					local u = r + sd
					local v = r - sd
					u = u < 0 and -((-u) ^ (1/3)) or u ^ (1/3)
					v = v < 0 and -((-v) ^ (1/3)) or v ^ (1/3)
					return p + u + v
				else
					local theta = math.atan2(sd, r) / 3
					local m = 2 * math.sqrt(q)
					return p - m * math.sin(theta + 0.5235987755982988), p + m * math.sin(theta - 0.5235987755982988), p + m * math.cos(theta)
				end
			elseif c then
				local p = -b / (2 * a)
				local disc = p * p - c / a
				if disc < 0 then return end
				local sd = math.sqrt(disc)
				return p - sd, p + sd
			elseif b then
				return -b / a
			end
		end
	end

	local function PredictTrajectory(origin, accel, target, speed, targetVel)
		local ld = target - origin
		accel = -accel
		targetVel = targetVel or Vector3.zero

		local r1, r2, r3, r4 = solve(
			accel:Dot(accel) * 0.25,
			accel:Dot(targetVel),
			accel:Dot(ld) + targetVel:Dot(targetVel) - speed * speed,
			ld:Dot(targetVel) * 2,
			ld:Dot(ld)
		)

		local t = (r1 and r1 > 0 and r1) or (r2 and r2 > 0 and r2) or (r3 and r3 > 0 and r3) or (r4 and r4 > 0 and r4)
		if not t then return nil, nil end

		local vel = (ld + targetVel * t + 0.5 * accel * t * t) / t
		return vel, t
	end

	-- Movement Cache

	local CACHE_SIZE = 15
	local MoveCache = {}

	local function UpdateMoveCache()
		RepInterface.operateOnAllEntries(function(player, entry)
			if not entry._isEnemy then return end
			local tp = entry._thirdPersonObject
			if not tp or not tp._head then return end

			if not MoveCache[player] then
				MoveCache[player] = {pos = {}, time = {}}
			end

			local c = MoveCache[player]
			table.insert(c.pos, tp._head.Position)
			table.insert(c.time, os.clock())

			if #c.pos > CACHE_SIZE then
				table.remove(c.pos, 1)
				table.remove(c.time, 1)
			end
		end)
	end

	local function GetTargetVelocity(player)
		local c = MoveCache[player]
		if not c or #c.pos < 2 then return Vector3.zero end
		local dt = c.time[#c.time] - c.time[1]
		if dt < 0.01 then return Vector3.zero end
		return (c.pos[#c.pos] - c.pos[1]) / dt
	end

	local function GetWeaponBulletData()
		local ok, controller = pcall(function()
			return WeaponControllerInterface:getActiveWeaponController()
		end)
		if not ok or not controller or not controller["_activeWeaponRegistry"] then return nil end
		local reg = controller["_activeWeaponRegistry"][1]
		if not reg then return nil end
		return reg["_weaponData"] or reg["weaponData"]
	end

	-- FOV Scaling

	local BASE_FOV = 70

	local function GetScaledFOVRadius()
		local radius = Options.FOVRadius.Value
		if Toggles.ScaleFOV.Value then
			radius = radius * (BASE_FOV / GetCamera().FieldOfView)
		end
		return radius
	end

	-- Target Finder

	local PredictedScreenPos = nil

	local RayParams = RaycastParams.new()
	RayParams.FilterType = Enum.RaycastFilterType.Exclude

	local function GetClosestTarget()
		local camera = GetCamera()
		local mouse = UserInputService:GetMouseLocation()
		local bestDist = GetScaledFOVRadius()
		local bestPos = nil
		local bestPart = nil
		local bestPlayer = nil

		if Toggles.VisibleCheck.Value then
			RayParams.FilterDescendantsInstances = {LocalPlayer.Character, camera}
		end

		RepInterface.operateOnAllEntries(function(player, entry)
			if not entry._isEnemy then return end

			local thirdPerson = entry._thirdPersonObject
			if not thirdPerson then return end

			local character = thirdPerson._characterModelHash
			if not character then return end

			local part = character[Options.HitPart.Value]
			if not part then return end

			local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
			if not onScreen or screenPos.Z <= 0 then return end

			if Toggles.VisibleCheck.Value then
				local origin = camera.CFrame.Position
				local ray = workspace:Raycast(origin, part.Position - origin, RayParams)
				if ray and not ray.Instance:IsDescendantOf(thirdPerson._characterModel or workspace) then return end
			end

			local dist = (Vector2.new(screenPos.X, screenPos.Y) - mouse).Magnitude
			if dist < bestDist then
				bestDist = dist
				bestPos = part.Position
				bestPart = part
				bestPlayer = player
			end
		end)

		return bestPos, bestPart, bestPlayer
	end

	-- Hooks

	local GRAVITY = Vector3.new(0, -196.2, 0)

	local OldBulletNew = BulletObject.new
	BulletObject.new = newcclosure(function(...)
		local args = {...}

		if Toggles.Aimbot.Value and Options.AimbotMode.Value == "Silent" and args[1]["extra"] and math.random(100) <= Options.Hitchance.Value then
			local target, _, targetPlayer = GetClosestTarget()
			if target then
				local wData = GetWeaponBulletData()
				local bulletSpeed = wData and wData["bulletspeed"] or 2000
				local accel = wData and wData["bulletacceleration"] or GRAVITY

				if Toggles.Prediction.Value and targetPlayer then
					local vel, _ = PredictTrajectory(args[1]["position"], accel, target, bulletSpeed, GetTargetVelocity(targetPlayer))
					if vel then
						args[1]["velocity"] = vel
					else
						args[1]["velocity"] = (target - args[1]["position"]).Unit * bulletSpeed
					end
				else
					args[1]["velocity"] = (target - args[1]["position"]).Unit * bulletSpeed
				end
			end
		end

		return OldBulletNew(table.unpack(args))
	end)

	local OldNetworkSend = NetworkClient.send
	NetworkClient.send = newcclosure(function(entry, name, ...)
		if name == "flaguser" then
			return
		end

		if name == "newbullets" and Toggles.Aimbot.Value and Options.AimbotMode.Value == "Silent" and math.random(100) <= Options.Hitchance.Value then
			local uniqueId, bulletData, time = ...

			for _, v in bulletData["bullets"] do
				local target, _, targetPlayer = GetClosestTarget()
				if target then
					if Toggles.Prediction.Value and targetPlayer then
						local wData = GetWeaponBulletData()
						local bulletSpeed = wData and wData["bulletspeed"] or 2000
						local accel = wData and wData["bulletacceleration"] or GRAVITY
						local vel, _ = PredictTrajectory(bulletData["firepos"], accel, target, bulletSpeed, GetTargetVelocity(targetPlayer))
						if vel then
							v[1] = vel.Unit
						else
							v[1] = (target - bulletData["firepos"]).Unit
						end
					else
						v[1] = (target - bulletData["firepos"]).Unit
					end
				end
			end
			return OldNetworkSend(entry, name, uniqueId, bulletData, time)
		end

		return OldNetworkSend(entry, name, ...)
	end)

	local OldApplyImpulse = RecoilSprings.applyImpulse
	RecoilSprings.applyImpulse = newcclosure(function(...)
		if Toggles.NoRecoil.Value then return end
		return OldApplyImpulse(...)
	end)

	local OldReload = FirearmObject.reload
	FirearmObject.reload = function(self)
		if Toggles.InstantReload.Value and self._spareCount > 0 then
			if self._spareCount >= self._weaponData.magsize then
				self._spareCount = self._spareCount - (self._weaponData.magsize - self._magCount)
				self._magCount = self._weaponData.magsize
			else
				self._magCount = self._spareCount
				self._spareCount = 0
			end
			OldNetworkSend(NetworkClient, "reload")
			return
		end
		return OldReload(self)
	end

