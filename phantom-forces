	Paint:Connect(function()
		if not ESPActive() then return end

		local ok, camera = pcall(GetCamera)
		if not ok or not camera then return end
		local camPos = camera.CFrame.Position

		RepInterface.operateOnAllEntries(function(player, entry)
			pcall(function()
				if not entry._isEnemy or not entry:isAlive() then return end

				local thirdPerson = entry._thirdPersonObject
				if not thirdPerson then return end

				local head = thirdPerson._head
				local torso = thirdPerson._torso
				if not head then return end

				local anchor = torso or head
				local headScreen, headVisible = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
				local feetScreen, feetVisible = camera:WorldToViewportPoint(anchor.Position - Vector3.new(0, 3, 0))
				if not headVisible and not feetVisible then return end

				local topY = headScreen.Y - 5
				local botY = feetScreen.Y + 2
				local height = botY - topY
				if height < 8 then return end
				local width = height * 0.45
				local centerX = headScreen.X

				if Toggles.ESPBox.Value then
					local topLeft = Vector2.new(centerX - width / 2, topY)
					local size = Vector2.new(width, height)

					DrawingImmediate.Rectangle(
						Vector2.new(topLeft.X - 1, topLeft.Y - 1),
						Vector2.new(size.X + 2, size.Y + 2),
						Color3.new(0, 0, 0), 1, 0, 1
					)
					DrawingImmediate.Rectangle(
						Vector2.new(topLeft.X + 1, topLeft.Y + 1),
						Vector2.new(size.X - 2, size.Y - 2),
						Color3.new(0, 0, 0), 1, 0, 1
					)
					DrawingImmediate.Rectangle(topLeft, size, Options.ESPBoxColor.Value, 1, 0, 1)
				end

				if Toggles.ESPName.Value then
					DrawingImmediate.OutlinedText(
						Vector2.new(centerX, topY - 16),
						0, 13,
						Options.ESPNameColor.Value, 1,
						Color3.new(0, 0, 0), 1,
						player.DisplayName, true
					)
				end

				if Toggles.ESPWeapon.Value then
					local weaponName = thirdPerson._weaponName or "None"
					DrawingImmediate.OutlinedText(
						Vector2.new(centerX, botY + 2),
						0, 13,
						Options.ESPWeaponColor.Value, 1,
						Color3.new(0, 0, 0), 1,
						weaponName, true
					)
				end

				if Toggles.ESPDistance.Value then
					local dist = math.floor((head.Position - camPos).Magnitude)
					local yOffset = Toggles.ESPWeapon.Value and 16 or 2
					DrawingImmediate.OutlinedText(
						Vector2.new(centerX, botY + yOffset),
						0, 13,
						Options.ESPDistanceColor.Value, 1,
						Color3.new(0, 0, 0), 1,
						dist .. "m", true
					)
				end

				if Toggles.ESPHealthBar.Value then
					local currentHealth, maxHealth = entry:getHealth()
					local healthFrac = 1
					if maxHealth and maxHealth > 0 then
						healthFrac = (currentHealth or 0) / maxHealth
					end

					local barWidth = 3
					local barX = centerX - width / 2 - barWidth - 2

					DrawingImmediate.FilledRectangle(
						Vector2.new(barX, topY),
						Vector2.new(barWidth, height),
						Color3.new(0, 0, 0), 0.5, 0
					)

					local fillHeight = height * healthFrac
					local healthColor = Color3.fromRGB(255 * (1 - healthFrac), 255 * healthFrac, 0)
					DrawingImmediate.FilledRectangle(
						Vector2.new(barX, topY + (height - fillHeight)),
						Vector2.new(barWidth, fillHeight),
						healthColor, 1, 0
					)

					DrawingImmediate.Rectangle(
						Vector2.new(barX, topY),
						Vector2.new(barWidth, height),
						Color3.new(0, 0, 0), 1, 0, 1
					)
				end

				if Toggles.Tracers.Value then
					local viewport = camera.ViewportSize
					local origin = Options.TracerOrigin.Value
					local fromPos
					if origin == "Center" then
						fromPos = Vector2.new(viewport.X / 2, viewport.Y / 2)
					elseif origin == "Mouse" then
						fromPos = UserInputService:GetMouseLocation()
					else
						fromPos = Vector2.new(viewport.X / 2, viewport.Y)
					end

					local toPos = Vector2.new(centerX, botY)
					DrawingImmediate.Line(fromPos, toPos, Color3.new(0, 0, 0), 1, 3)
					DrawingImmediate.Line(fromPos, toPos, Options.TracerColor.Value, 1, 1)
				end
			end)
		end)
	end)

	-- Chams

	local ChamsFolder = Instance.new("Folder")
	ChamsFolder.Name = "InertiaChams"
	ChamsFolder.Parent = game:GetService("CoreGui")

	local ChamsHighlights = {}

	local function UpdateChams()
		if not Toggles.Chams.Value then
			for _, hl in ChamsHighlights do
				hl:Destroy()
			end
			table.clear(ChamsHighlights)
			return
		end

		local alive = {}
		RepInterface.operateOnAllEntries(function(player, entry)
			if not entry._isEnemy or not entry:isAlive() then return end
			local tp = entry._thirdPersonObject
			if not tp or not tp._characterModel then return end

			alive[player] = true

			local hl = ChamsHighlights[player]
			if not hl or not hl.Parent then
				hl = Instance.new("Highlight")
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.Parent = ChamsFolder
				ChamsHighlights[player] = hl
			end

			hl.Adornee = tp._characterModel
			hl.FillColor = Options.ChamsFillColor.Value
			hl.OutlineColor = Options.ChamsOutlineColor.Value
			hl.FillTransparency = Options.ChamsFillTransparency.Value
			hl.OutlineTransparency = 0
		end)

		for player, hl in ChamsHighlights do
			if not alive[player] then
				hl:Destroy()
				ChamsHighlights[player] = nil
			end
		end
	end

	-- World

	local Lighting = game:GetService("Lighting")
	local DefaultAmbient = Lighting.Ambient
	local DefaultOutdoorAmbient = Lighting.OutdoorAmbient
	local DefaultBrightness = Lighting.Brightness
	local DefaultFogEnd = Lighting.FogEnd
	local DefaultFogStart = Lighting.FogStart
	local DefaultSkybox = nil

	local sky = Lighting:FindFirstChildWhichIsA("Sky")
	if sky then
		DefaultSkybox = {
			SkyboxBk = sky.SkyboxBk,
			SkyboxDn = sky.SkyboxDn,
			SkyboxFt = sky.SkyboxFt,
			SkyboxLf = sky.SkyboxLf,
			SkyboxRt = sky.SkyboxRt,
			SkyboxUp = sky.SkyboxUp,
		}
	end

	local SkyboxPresets = {
		Neptune   = { "218955819", "218953419", "218954524", "218958493", "218957134", "218950090" },
		Nebula    = { "159454299", "159454296", "159454293", "159454286", "159454300", "159454288" },
		Vaporwave = { "1417494030", "1417494146", "1417494253", "1417494402", "1417494499", "1417494643" },
		Clouds    = { "570557514", "570557775", "570557559", "570557620", "570557672", "570557727" },
		Twilight  = { "264908339", "264907909", "264909420", "264909758", "264908886", "264907379" },
		Minecraft = { "1876545003", "1876544331", "1876542941", "1876543392", "1876543764", "1876544642" },
		Chill     = { "5084575798", "5084575916", "5103949679", "5103948542", "5103948784", "5084576400" },
		Redshift  = { "401664839", "401664862", "401664960", "401664881", "401664901", "401664936" },
	}

	local function ApplySkybox(preset)
		local sky = Lighting:FindFirstChildWhichIsA("Sky")
		if preset == "Default" then
			if sky and DefaultSkybox then
				for k, v in DefaultSkybox do
					sky[k] = v
				end
			end
			return
		end

		if preset == "Void" then
			if sky then sky:Destroy() end
			return
		end

		local ids = SkyboxPresets[preset]
		if not ids then return end

		if not sky then
			sky = Instance.new("Sky")
			sky.Parent = Lighting
		end
		sky.SkyboxBk = "rbxassetid://" .. ids[1]
		sky.SkyboxDn = "rbxassetid://" .. ids[2]
		sky.SkyboxFt = "rbxassetid://" .. ids[3]
		sky.SkyboxLf = "rbxassetid://" .. ids[4]
		sky.SkyboxRt = "rbxassetid://" .. ids[5]
		sky.SkyboxUp = "rbxassetid://" .. ids[6]
	end

	local lastSkybox = "Default"

	local function UpdateWorld()
		if Toggles.Fullbright.Value then
			Lighting.Ambient = Color3.new(1, 1, 1)
			Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
			Lighting.Brightness = Options.Brightness.Value
		else
			Lighting.Ambient = DefaultAmbient
			Lighting.OutdoorAmbient = DefaultOutdoorAmbient
			Lighting.Brightness = DefaultBrightness
		end

		if Toggles.NoFog.Value then
			Lighting.FogEnd = 1e10
			Lighting.FogStart = 1e10
		else
			Lighting.FogEnd = DefaultFogEnd
			Lighting.FogStart = DefaultFogStart
		end

		local currentSkybox = Options.Skybox.Value
		if currentSkybox ~= lastSkybox then
			ApplySkybox(currentSkybox)
			lastSkybox = currentSkybox
		end
	end

	-- Viewmodel Chams

	local VMOriginals = {}

	local function UpdateViewmodelChams()
		local camera = GetCamera()
		for _, model in camera:GetChildren() do
			if model.ClassName ~= "Model" then continue end

			local isArm = model:FindFirstChild("Arm") ~= nil
			local toggle = isArm and "ArmChams" or "WeaponChams"
			local colorOpt = isArm and "ArmChamsColor" or "WeaponChamsColor"

			for _, part in model:GetDescendants() do
				if not part:IsA("BasePart") then continue end

				if not VMOriginals[part] then
					VMOriginals[part] = { Material = part.Material, Color = part.Color }
				end

				if Toggles[toggle].Value then
					part.Material = Enum.Material.ForceField
					part.Color = Options[colorOpt].Value
				else
					part.Material = VMOriginals[part].Material
					part.Color = VMOriginals[part].Color
				end
			end
		end
	end

	-- Render Loop

	RunService.RenderStepped:Connect(function()
		UpdateMoveCache()
		UpdateChams()
		UpdateViewmodelChams()
		UpdateWorld()

		local mouse = UserInputService:GetMouseLocation()
		local fovRadius = GetScaledFOVRadius()
		FOVCircle.Visible = Toggles.ShowFOV.Value
		FOVCircle.Radius = fovRadius
		FOVCircle.Color = Options.FOVColor.Value
		FOVCircle.Position = mouse
		FOVOutline.Visible = Toggles.ShowFOV.Value
		FOVOutline.Radius = fovRadius
		FOVOutline.Position = mouse

		PredictedScreenPos = nil

		if Toggles.Aimbot.Value and Options.AimbotMode.Value == "Memory" and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			local targetPos, targetPart, targetPlayer = GetClosestTarget()
			if targetPart and targetPos then
				local camera = GetCamera()
				local aimPos = targetPos

				if Toggles.Prediction.Value and targetPlayer then
					local wData = GetWeaponBulletData()
					local bulletSpeed = wData and wData["bulletspeed"] or 2000
					local accel = wData and wData["bulletacceleration"] or GRAVITY
					local vel, t = PredictTrajectory(camera.CFrame.Position, accel, targetPos, bulletSpeed, GetTargetVelocity(targetPlayer))
					if t then
						aimPos = targetPos + GetTargetVelocity(targetPlayer) * t
						local predScreen = camera:WorldToViewportPoint(aimPos)
						PredictedScreenPos = Vector2.new(predScreen.X, predScreen.Y)
					end
				end

				local screenPos = camera:WorldToViewportPoint(aimPos)
				local center = camera.ViewportSize / 2
				local deltaX = (screenPos.X - center.X) / Options.Smoothing.Value
				local deltaY = (screenPos.Y - center.Y) / Options.Smoothing.Value
				mousemoverel(deltaX, deltaY)
			end
		elseif Toggles.Aimbot.Value and Toggles.Prediction.Value and Toggles.PredictionDot.Value then
			local targetPos, _, targetPlayer = GetClosestTarget()
			if targetPos and targetPlayer then
				local camera = GetCamera()
				local wData = GetWeaponBulletData()
				local bulletSpeed = wData and wData["bulletspeed"] or 2000
				local accel = wData and wData["bulletacceleration"] or GRAVITY
				local _, t = PredictTrajectory(camera.CFrame.Position, accel, targetPos, bulletSpeed, GetTargetVelocity(targetPlayer))
				if t then
					local predWorld = targetPos + GetTargetVelocity(targetPlayer) * t
					local predScreen = camera:WorldToViewportPoint(predWorld)
					PredictedScreenPos = Vector2.new(predScreen.X, predScreen.Y)
				end
			end
		end

		local showDot = Toggles.PredictionDot.Value and Toggles.Prediction.Value and PredictedScreenPos ~= nil
		PredDot.Visible = showDot
		PredDotOutline.Visible = showDot
		if showDot then
			PredDot.Position = PredictedScreenPos
			PredDot.Color = Options.PredictionDotColor.Value
			PredDotOutline.Position = PredictedScreenPos
		end

		if Toggles.NoSpread.Value or Toggles.SmallCrosshair.Value or Toggles.NoCrosshair.Value then
			ApplyWeaponMods()
		end
	end)
else
	setfflag("DebugRunParallelLuaOnMainThread", "True")

	local notice = Drawing.new("Text")
	notice.Visible = true
	notice.Text = "FFlag not detected. Setting it and rejoining..."
	notice.Size = 20
	notice.Color = Color3.fromRGB(255, 255, 255)
	notice.Outline = true
	notice.OutlineColor = Color3.fromRGB(0, 0, 0)
	notice.Center = true
	notice.Position = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2 - 50)
	notice.ZIndex = 10

	queueonteleport('loadstring(game:HttpGet("https://raw.githubusercontent.com/ynlj32-ctrl/inertia/refs/heads/main/phantom-forces", true))()')
	task.wait(2)
	game:GetService("TeleportService"):Teleport(game.PlaceId, game:GetService("Players").LocalPlayer)
end
