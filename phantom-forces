	local function ApplyWeaponMods()
		local ok, controller = pcall(function()
			return WeaponControllerInterface:getActiveWeaponController()
		end)
		if not ok or not controller or not controller["_activeWeaponRegistry"] then return end

		for _, reg in controller["_activeWeaponRegistry"] do
			local data = reg["_weaponData"]
			if not data then continue end

            setreadonly(data, false)

			if Toggles.NoSpread.Value then
				rawset(data, "hipfirespread", 0.000001)
				rawset(data, "hipfirestability", 0.000001)
				rawset(data, "hipfirespreadrecover", 0.000001)
			end

			if Toggles.SmallCrosshair.Value then
				rawset(data, "crosssize", 10)
				rawset(data, "crossexpansion", 0)
				rawset(data, "crossspeed", 100)
				rawset(data, "crossdamper", 1)
			end

			if Toggles.NoCrosshair.Value then
				rawset(data, "crosssize", 1000000000)
				rawset(data, "crossexpansion", 0)
				rawset(data, "crossspeed", 100)
				rawset(data, "crossdamper", 1)
			end
            setreadonly(data, true)
		end
	end


	-- ESP

	local Paint = DrawingImmediate.GetPaint(1)

	local ESPActive = function()
