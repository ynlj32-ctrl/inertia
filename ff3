-- Angle Enhancer (boost on shift lock release + jump)
local function setupAngleEnhancer(character)
	if not character then return end
	local angleTick = 0
	local shiftLock = false
	local lastShiftLock = false

	UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
		shiftLock = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
	end)

	local humanoid = character:WaitForChild("Humanoid")
	local hrp = character:WaitForChild("HumanoidRootPart")

	humanoid.Jumping:Connect(function()
		if humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then return end
		if not Toggles.AngleEnhancer.Value then return end
		if (os.clock() - angleTick) > 0.2 then return end
		hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity + Vector3.new(0, Options.AngleValue.Value, 0)
	end)

	task.spawn(function()
		while task.wait() do
			if not character.Parent then break end
			if not shiftLock and lastShiftLock then
				angleTick = os.clock()
			end
			lastShiftLock = shiftLock
		end
	end)
end

