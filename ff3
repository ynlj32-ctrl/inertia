local function getCharacter()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil, nil, nil end
	return char, char.HumanoidRootPart, char:FindFirstChild("Humanoid")
end

local function getFootball()
	local _, hrp = getCharacter()
	if not hrp then return nil, math.huge end
	local closest, minDist = nil, math.huge
	for _, child in pairs(Workspace:GetChildren()) do
		if child:IsA("BasePart") and child.Name == "Football" then
			local dist = (child.Position - hrp.Position).Magnitude
			if dist < minDist then closest, minDist = child, dist end
		end
	end
	if not closest then
		local found = Workspace:FindFirstChild("Football", true)
		if found and found:IsA("BasePart") then
			closest = found
			minDist = (found.Position - hrp.Position).Magnitude
		end
	end
	return closest, minDist
end

local function getCatchParts()
	local char = LocalPlayer.Character
	if not char then return {} end
	local parts = {}
	for _, name in ipairs({"CatchRight", "CatchLeft", "RightHand", "LeftHand", "Right Arm", "Left Arm"}) do
		local p = char:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			table.insert(parts, p)
		end
	end
	if #parts == 0 then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then table.insert(parts, hrp) end
	end
	return parts
end

local function getBallCarrier()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Team ~= LocalPlayer.Team and plr.Character then
			local tool = plr.Character:FindFirstChildWhichIsA("Tool")
			if tool then return plr.Character end
		end
	end
	return nil
end

local function beamProjectile(g, v0, x0, t1)
	local c = 0.125
	local p3 = 0.5 * g * t1 * t1 + v0 * t1 + x0
	local p2 = p3 - (g * t1 * t1 + v0 * t1) / 3
	local p1 = (c * g * t1 * t1 + 0.5 * v0 * t1 + x0 - c * (x0 + p3)) / (3 * c) - p2
	local curve0 = (p1 - x0).Magnitude
	local curve1 = (p2 - p3).Magnitude
	local b = (x0 - p3).Unit
	local r1 = (p1 - x0).Unit
	local u1 = r1:Cross(b).Unit
	local r2 = (p2 - p3).Unit
	local u2 = r2:Cross(b).Unit
	b = u1:Cross(r1).Unit
	local cf1 = CFrame.new(x0.X, x0.Y, x0.Z, r1.X, u1.X, b.X, r1.Y, u1.Y, b.Y, r1.Z, u1.Z, b.Z)
	local cf2 = CFrame.new(p3.X, p3.Y, p3.Z, r2.X, u2.X, b.X, r2.Y, u2.Y, b.Y, r2.Z, u2.Z, b.Z)
	return curve0, -curve1, cf1, cf2
end

