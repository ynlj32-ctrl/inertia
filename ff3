local RNG = Random.new()

local function jitter(base, variance)
	return base + RNG:NextNumber(-variance, variance)
end

local function humanDelay(min, max)
	task.wait(RNG:NextNumber(min, max))
end

local function offsetPos(pos, radius)
	return pos + Vector3.new(
		RNG:NextNumber(-radius, radius),
		0,
		RNG:NextNumber(-radius, radius)
	)
end

