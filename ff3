	bb.Adornee = ball
	bb.Size = UDim2.new(0, 100, 0, 30)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = game:GetService("CoreGui")
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 170, 0)
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Parent = bb
	espObjects[ball] = { billboard = bb, label = label }
end

RunService.Heartbeat:Connect(function()
	if not Toggles.BallESP.Value then
		cleanupESP()
		return
	end
	local _, hrp = getCharacter()
	for _, child in pairs(Workspace:GetChildren()) do
		if child:IsA("BasePart") and child.Name == "Football" then
			createBillboard(child)
		end
	end
	for obj, data in pairs(espObjects) do
		if not obj.Parent then
			data.billboard:Destroy()
			espObjects[obj] = nil
		else
			local dist = hrp and math.floor((hrp.Position - obj.Position).Magnitude) or 0
			data.label.Text = "Football [" .. dist .. "]"
			data.label.TextColor3 = Options.BallESPColor.Value
		end
	end
end)

-- Ball Path
local ballPathConn
Toggles.BallPath:OnChanged(function()
	if not Toggles.BallPath.Value then
		if ballPathConn then ballPathConn:Disconnect(); ballPathConn = nil end
		for _, obj in ipairs(Workspace.Terrain:GetChildren()) do
			if obj.Name == "BallPath" or obj.Name == "BallPathAtt" then obj:Destroy() end
		end
		return
	end
	if ballPathConn then ballPathConn:Disconnect() end
	ballPathConn = Workspace.ChildAdded:Connect(function(ball)
		if not (ball:IsA("BasePart") and ball.Name == "Football") then return end
		task.wait()
		local vel = ball.Velocity
		local pos = ball.Position
		local c0, c1, cf1, cf2 = beamProjectile(Vector3.new(0, -28, 0), vel, pos, 10)
		local a0 = Instance.new("Attachment"); a0.Name = "BallPathAtt"; a0.Parent = Workspace.Terrain
		local a1 = Instance.new("Attachment"); a1.Name = "BallPathAtt"; a1.Parent = Workspace.Terrain
		a0.CFrame = a0.Parent.CFrame:Inverse() * cf1
		a1.CFrame = a1.Parent.CFrame:Inverse() * cf2
		local beam = Instance.new("Beam"); beam.Name = "BallPath"; beam.Parent = Workspace.Terrain
		beam.Attachment0 = a0; beam.Attachment1 = a1
		beam.CurveSize0 = c0; beam.CurveSize1 = c1
		beam.Segments = 1750; beam.Width0 = 1; beam.Width1 = 1
		local col = Options.BallPathColor.Value
		beam.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, col), ColorSequenceKeypoint.new(1, col) })
		beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.01, 0), NumberSequenceKeypoint.new(0.99, 0), NumberSequenceKeypoint.new(1, 0.01) })
		local hbConn
		hbConn = RunService.Heartbeat:Connect(function()
			if ball.Velocity.Magnitude < 1 then
				hbConn:Disconnect(); beam:Destroy(); a0:Destroy(); a1:Destroy()
			end
		end)
		task.spawn(function()
			repeat task.wait() until not ball.Parent
			if beam.Parent then beam:Destroy() end
			if a0.Parent then a0:Destroy() end
			if a1.Parent then a1:Destroy() end
		end)
	end)
end)

-- Player ESP
local playerEspObjects = {}
local playerHighlights = {}

local function cleanupPlayerESP()
	for plr, data in pairs(playerEspObjects) do
		if data.billboard then data.billboard:Destroy() end
		playerEspObjects[plr] = nil
	end
	for plr, hl in pairs(playerHighlights) do
		if hl then hl:Destroy() end
		playerHighlights[plr] = nil
	end
end

RunService.Heartbeat:Connect(function()
	local espOn = Toggles.PlayerESP.Value
	local hlOn = Toggles.PlayerHighlight.Value
	if not espOn and not hlOn then
		cleanupPlayerESP()
		return
	end
	local _, hrp = getCharacter()
	local espColor = Options.PlayerESPColor.Value

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == LocalPlayer then continue end
		local tChar = plr.Character
		if not tChar then continue end
		local tHrp = tChar:FindFirstChild("HumanoidRootPart")
		local tHead = tChar:FindFirstChild("Head")
		if not tHrp or not tHead then continue end

		if espOn then
			if not playerEspObjects[plr] then
				local bb = Instance.new("BillboardGui")
				bb.Adornee = tHead
				bb.Size = UDim2.new(0, 120, 0, 30)
				bb.StudsOffset = Vector3.new(0, 2.5, 0)
				bb.AlwaysOnTop = true
				bb.Parent = game:GetService("CoreGui")
				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(1, 0, 1, 0)
				label.BackgroundTransparency = 1
				label.TextStrokeTransparency = 0
				label.Font = Enum.Font.GothamBold
				label.TextScaled = true
				label.Parent = bb
				playerEspObjects[plr] = { billboard = bb, label = label }
			end
			local data = playerEspObjects[plr]
			local dist = hrp and math.floor((hrp.Position - tHrp.Position).Magnitude) or 0
			local teamTag = (plr.Team == LocalPlayer.Team) and " [T]" or " [E]"
			data.label.Text = plr.Name .. teamTag .. " [" .. dist .. "]"
			data.label.TextColor3 = (plr.Team == LocalPlayer.Team) and Color3.fromRGB(50, 255, 50) or espColor
		end

		if hlOn then
			if not playerHighlights[plr] or not playerHighlights[plr].Parent then
				local hl = Instance.new("Highlight")
				hl.FillTransparency = 0.7
				hl.OutlineTransparency = 0
				hl.Parent = tChar
				playerHighlights[plr] = hl
			end
			local hl = playerHighlights[plr]
			if plr.Team == LocalPlayer.Team then
				hl.FillColor = Color3.fromRGB(50, 255, 50)
				hl.OutlineColor = Color3.fromRGB(50, 255, 50)
			else
				hl.FillColor = espColor
				hl.OutlineColor = espColor
			end
		end
	end

	for plr, data in pairs(playerEspObjects) do
		if not plr.Parent or not espOn then
			data.billboard:Destroy()
			playerEspObjects[plr] = nil
		end
	end
	for plr, hl in pairs(playerHighlights) do
		if not plr.Parent or not hlOn then
			hl:Destroy()
			playerHighlights[plr] = nil
		end
	end
end)

