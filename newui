-- Tears everything down and hands the mouse back to the game. Destroying lib.ui calls this too.
function lib:unload()
	if self.unloaded then
		return
	end


	self.unloaded = true
	self.visible = false


	self:closetasks(self.connections)
	self:closetasks(self.overlayLinks)
	for _, window in next, self['BROWEN😂😂'] do
		if window.links then
			self:closetasks(window.links)
		end
	end
	for _, entry in next, self.overlays.keybindItems do
		entry.data.pressed = false
		entry.data.active = false
	end


	pcall(function()
		self.ui:Destroy()
	end)
end

lib.ui.Destroying:Connect(function()
	lib:unload()
end)

local function overlayLabel(parent, properties)
	properties.Parent = parent
	properties.FontFace = properties.FontFace or Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	properties.TextColor3 = properties.TextColor3 or lib.theme.t2
	properties.TextSize = properties.TextSize or 13
	properties.BackgroundTransparency = properties.BackgroundTransparency or 1
	return new("TextLabel", properties)
end

local function makeDraggable(frame)
	local dragging = false
	local dragStart
	local startPosition
	local moveConnection
	local endConnection

	local function stopDragging()
		dragging = false
	end

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = frame.Position
		end
	end)

	moveConnection = lib:connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)

	endConnection = lib:connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			stopDragging()
		end
	end)

	frame.Destroying:Connect(function()
		if moveConnection then moveConnection:Disconnect() end
		if endConnection then endConnection:Disconnect() end
	end)
end

function lib:watermark(text: string?, position: UDim2?)
	lib:closetasks(lib.overlayLinks)
	lib.overlayLinks = {}
	if lib.overlays.watermark then
		lib.overlays.watermark:Destroy()
	end

	local frame = new("Frame", {
		Parent = lib.ui;
		Name = "Watermark";
		BackgroundColor3 = Color3.fromRGB(18, 18, 18);
		BorderSizePixel = 0;
		Position = position or UDim2.fromOffset(12, 12);
		Size = UDim2.fromOffset(286, 24);
		Active = true;
		ZIndex = 100;
	})
	makeDraggable(frame)
	local watermarkScale = new("UIScale", {Parent = frame; Name = "AnimationScale"; Scale = 0.94;})
	TweenService:Create(watermarkScale, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
	new("UIStroke", {Parent = frame; Color = Color3.fromRGB(38, 38, 38); ApplyStrokeMode = Enum.ApplyStrokeMode.Border;})
	local accent = new("Frame", {Parent = frame; BackgroundColor3 = lib.theme.accent; BorderSizePixel = 0; Size = UDim2.fromOffset(3, 24); ZIndex = 101;})
	local status = overlayLabel(frame, {
		Name = "Text";
		Position = UDim2.fromOffset(10, 0);
		Size = UDim2.new(1, -16, 1, 0);
		Text = text or "Inertia";
		TextColor3 = lib.theme.t;
		TextXAlignment = Enum.TextXAlignment.Left;
		ZIndex = 101;
	})
	lib.overlays.watermark = frame
	local runService = game:GetService("RunService")
	local stats = game:GetService("Stats")
	local lastTime = os.clock()
	local frames = 0
	lib.overlayLinks[1] = runService.RenderStepped:Connect(function()
		frames = frames + 1
		local now = os.clock()
		if now - lastTime >= 0.5 then
			local fps = math.floor(frames / (now - lastTime) + 0.5)
			frames = 0
			lastTime = now
			local ping = 0
			pcall(function()
				ping = math.floor(stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
			end)
			status.Text = string.format("%s  |  %d FPS  |  %d ms", text or "Inertia", fps, ping)
		end
		local pulse = (math.sin(now * 2.5) + 1) * 0.5
		accent.BackgroundTransparency = 0.15 + pulse * 0.35
		frame.BackgroundTransparency = 0.04 + pulse * 0.06
	end)
	return frame
end

function lib:setVisible(visible: boolean?)
	if lib.unloaded then
		return false
	end
	lib.visible = visible == nil and not lib.visible or visible
	if not lib.visible then
		lib:closePopups()
	end
	for _, item in next, lib['BROWEN😂😂'] do
		if item.i then
			local scale = item.i:FindFirstChild("VisibilityScale") or new("UIScale", {Parent = item.i; Name = "VisibilityScale"; Scale = 1;})
			if lib.visible then
				item.i.Visible = true
				scale.Scale = 0.96
				TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
			else
				TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.96}):Play()
				task.delay(0.16, function()
					if not lib.visible and item.i then
						item.i.Visible = false
					end
				end)
			end
		end
	end

	return lib.visible
end

