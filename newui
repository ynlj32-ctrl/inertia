function lib.subelements:addkiki(...)
	-- BOIIIIIII KIKI DO U LOVE MEEEEEEEEEE😂😂😂😂😂😂😂😂😂🧅🧅
	local ElementData = lib:overwrite({
		text = 'browne';
		flag = nil;
		mode = "Click";
		val = nil;

		changed = function() end;
		modechanged = function() end;
		call = function() end;
		active = false;
	}, ... or {})
	setmetatable(ElementData, lib.subelements)

	local ElementButton = new("TextButton", { Parent = self.c2, AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Color3.fromRGB(18, 18, 18), BorderColor3 = Color3.fromRGB(0, 0, 0), BorderSizePixel = 0, FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Size = UDim2.fromScale(1, 1), Text = "", TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 14, TextTransparency = 1, }) :: TextButton 
	local ButtonLabel = new("TextLabel", { Parent = ElementButton, AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 1, BorderColor3 = Color3.fromRGB(0, 0, 0), BorderSizePixel = 0, FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Size = UDim2.fromScale(0, 1), Text = "...", TextColor3 = Color3.fromRGB(152, 152, 152), TextSize = 14, }) 
	new("UIStroke", { Parent = ElementButton, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, }) 
	new("UIStroke", { Parent = ElementButton, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, BorderStrokePosition = Enum.BorderStrokePosition.Inner, Color = Color3.fromRGB(28, 28, 28), }) 
	new("UIPadding", { Parent = ElementButton, PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), }) 

	local function gsub(e)
		return (tostring(e)
			:gsub('Enum%.KeyCode%.', '')
			:gsub('Enum%.UserInputType%.', '')
			:gsub('ouse', '')
			:gsub('utton', ''))
	end

	-- Any of these (or nil/false) means unbound. Unbound is stored as false so configs keep it.
	local Unbound = {
		RightSuper = true; LeftSuper = true; BackSlash = true; Backspace = true;
		Unknown = true; Return = true; Escape = true; None = true; ['?'] = true; [''] = true;
	}

	local function refresh()
		if ElementData._refreshKeybind then
			ElementData._refreshKeybind()
		end
	end

	function ElementData:Set(Key : any)
		local stripped = (Key ~= nil and Key ~= false) and gsub(Key) or nil
		if stripped and Unbound[stripped] then
			stripped = nil
		end

		ElementData.val = stripped
		ButtonLabel.Text = stripped or '?'
		lib:setFlag(getFlagName(ElementData), stripped or false)
		refresh()
	end

	local function matches(Input: InputObject): boolean
		local key = ElementData.val
		return key ~= nil and (gsub(Input.KeyCode) == key or gsub(Input.UserInputType) == key)
	end

	local modeFlag = getFlagName(ElementData) and (getFlagName(ElementData) .. '_mode') or nil
	local modeList = ElementData.modes or (ElementData.mode ~= 'Click' and {'Always'; 'Toggle'; 'Hold';} or nil)
	local modeMenu, modeButtons, modeReady = nil, {}, false

	function ElementData:SetMode(mode : string)
		if mode ~= 'Always' and mode ~= 'Toggle' and mode ~= 'Hold' and mode ~= 'Click' then
			return
		end

		-- Re-applying the current mode (a config load) must not switch an active Toggle off.
		if mode ~= ElementData.mode or not modeReady then
			ElementData.pressed = mode == 'Always'
			ElementData.active = mode == 'Always'
		end
		ElementData.mode = mode
		modeReady = true
		if modeList and modeFlag then
			lib:setFlag(modeFlag, mode)
		end

		for option, button in next, modeButtons do
			button.TextColor3 = option == mode and lib.theme.accent or lib.theme.t2
		end

		refresh()

		local success, err = pcall(ElementData.modechanged, mode)
		if not success then warn(err) end
	end

	if modeList then
		modeMenu = new("Frame", { Parent = lib.ui; Name = "KeybindModes"; Visible = false; AutomaticSize = Enum.AutomaticSize.Y; BackgroundColor3 = Color3.fromRGB(18, 18, 18); BorderColor3 = Color3.fromRGB(0, 0, 0); BorderSizePixel = 0; Size = UDim2.fromOffset(70, 0); ZIndex = 120; }) :: Frame
		new("UIStroke", { Parent = modeMenu; ApplyStrokeMode = Enum.ApplyStrokeMode.Border; })
		new("UIListLayout", { Parent = modeMenu; Padding = UDim.new(0, 1); SortOrder = Enum.SortOrder.LayoutOrder; })

		for index, option in next, modeList do
			local button = new("TextButton", { Parent = modeMenu; LayoutOrder = index; AutoButtonColor = false; BackgroundTransparency = 1; BorderSizePixel = 0; FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal); Size = UDim2.new(1, 0, 0, 16); Text = option; TextColor3 = lib.theme.t2; TextSize = 14; TextXAlignment = Enum.TextXAlignment.Left; ZIndex = 121; }) :: TextButton
			new("UIPadding", { Parent = button; PaddingLeft = UDim.new(0, 4); })
			modeButtons[option] = button

			button.Activated:Connect(function()
				ElementData:SetMode(option)
				modeMenu.Visible = false
			end)
		end

		lib:addPopup(modeMenu)

		ElementButton.MouseButton2Click:Connect(function()
			if ElementData.skipMenu then
				ElementData.skipMenu = false
				return
			end
			if modeMenu.Visible then
				modeMenu.Visible = false
				return
			end
			lib:closePopups(modeMenu)
			modeMenu.Position = UDim2.fromOffset(ElementButton.AbsolutePosition.X, ElementButton.AbsolutePosition.Y + ElementButton.AbsoluteSize.Y + 2)
			modeMenu.Visible = true
		end)

		lib:connect(UserInputService.InputBegan, function(Input)
			if modeMenu.Visible and Input.UserInputType == Enum.UserInputType.MouseButton1 and not mouseOver(modeMenu) then
				modeMenu.Visible = false
			end
		end)
	end

	ElementButton.Activated:Connect(function()
		if ElementData.skipActivate then
			ElementData.skipActivate = false
			return
		end
		ElementData.Editing = true
		ButtonLabel.Text = '...'
	end)

	local function release()
		if ElementData.mode == 'Hold' then
			ElementData.pressed = false
			ElementData.active = false
			refresh()
		elseif ElementData.mode == 'Click' then
			ElementData.active = false
			refresh()
		end
	end

	lib:connect(UserInputService.InputBegan, function(Input, GameProcessedEvent)
		local kind = Input.UserInputType

		if ElementData.Editing then
			ElementData.Editing = false

			-- Clicking the key button again cancels instead of binding MB1.
			if kind == Enum.UserInputType.MouseButton1 and mouseOver(ElementButton) then
				ElementData.skipActivate = true
				ButtonLabel.Text = ElementData.val or '?'
				return
			end
			-- Binding MB2 on the button itself must not also pop the mode menu open.
			if kind == Enum.UserInputType.MouseButton2 and mouseOver(ElementButton) then
				ElementData.skipMenu = true
			end

			ElementData:Set(kind == Enum.UserInputType.Keyboard and Input.KeyCode or kind)
			return
		end

		-- A fresh press means any skip left over from a click released off the button is stale.
		if kind == Enum.UserInputType.MouseButton1 then
			ElementData.skipActivate = false
		elseif kind == Enum.UserInputType.MouseButton2 then
			ElementData.skipMenu = false
		end

		if GameProcessedEvent or not matches(Input) then
			return
		end

		if ElementData.mode == 'Hold' then
			ElementData.pressed = true
			ElementData.active = true
			refresh()

			while ElementData.pressed and ElementData.mode == 'Hold' and not lib.unloaded do task.wait()
				local success, err = pcall(ElementData.call, ElementData.val)
				if not success then warn(err) end
			end
		elseif ElementData.mode == 'Toggle' then
			ElementData.pressed = not ElementData.pressed
			ElementData.active = ElementData.pressed
			refresh()
			local success, err = pcall(ElementData.call, ElementData.val, ElementData.pressed)
			if not success then warn(err) end
		elseif ElementData.mode == 'Click' then
			ElementData.active = true
			refresh()
			local success, err = pcall(ElementData.call, ElementData.val)
			if not success then warn(err) end
		end
	end)

	-- No gameProcessed filter on release: letting go over the menu or chat must still end a Hold.
	lib:connect(UserInputService.InputEnded, function(Input)
		if matches(Input) then
			release()
		end
	end)

	-- Alt-tabbing mid-hold never delivers InputEnded.
	lib:connect(UserInputService.WindowFocusReleased, release)

	ElementData:Set(ElementData.val)
	lib:_registerKeybind(ElementData, ElementData.text, ElementData.val)
	ElementData:SetMode(ElementData.mode)

	registerFlag(ElementData, function(value) ElementData:Set(value) end, ElementData.val or false)
	if modeList and modeFlag then
		bindFlag(modeFlag, function(value) ElementData:SetMode(value) end, ElementData.mode, ElementData.save)
	end

	return ElementData
end

