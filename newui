-- Every service-level connection goes through here so lib:unload() can cut them all.
function lib:connect(signal: RBXScriptSignal, callback: (...any) -> ())
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

-- Floating frames (dropdown lists, colour pickers, keybind mode menus) parented to lib.ui.
-- They are not children of the window, so hiding the window or switching tabs has to close them.
function lib:addPopup(frame: GuiObject, onClose: (() -> ())?)
	table.insert(self.popups, {frame = frame; onClose = onClose;})
end

function lib:closePopups(except: GuiObject?)
	for _, popup in next, self.popups do
		if popup.frame ~= except and popup.frame.Parent and popup.frame.Visible then
			popup.frame.Visible = false
			if popup.onClose then popup.onClose() end
		end
	end
end

local function mouseOver(gui: GuiObject): boolean
	local position, size = gui.AbsolutePosition, gui.AbsoluteSize
	return Mouse.X >= position.X and Mouse.X <= position.X + size.X
		and Mouse.Y >= position.Y and Mouse.Y <= position.Y + size.Y
end

function lib:setFlag(flag: string?, value: any)
	if flag and flag ~= '' then
		self.flags[flag] = value
	end
