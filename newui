local function serializeValue(value)
	if typeof(value) == 'Color3' then
		return {__type = 'Color3'; r = value.R; g = value.G; b = value.B;}
	end
	if type(value) == 'table' then
		local result = {}
		for key, child in pairs(value) do
			result[key] = serializeValue(child)
		end
		return result
	end
	return value
end

local function deserializeValue(value)
	if type(value) == 'table' and value.__type == 'Color3' then
		return Color3.new(value.r, value.g, value.b)
	end
	if type(value) == 'table' then
		local result = {}
		for key, child in pairs(value) do
			result[key] = deserializeValue(child)
		end
		return result
	end
	return value
end

local function copyValue(value)
	if type(value) ~= 'table' then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = copyValue(child)
	end
	return result
end

function lib:configName(name: string?): string
	local configName = (tostring(name or ''):gsub('[^%w%-_ ]', ''):gsub('^%s+', ''):gsub('%s+$', ''))
	return configName ~= '' and configName or 'Inertia'
end

function lib:configExists(name: string?): boolean
	local filename = 'Inertia/' .. self:configName(name) .. '.json'
	if type(isfile) == 'function' then
		local success, exists = pcall(isfile, filename)
		return success and exists == true
	end
	return type(readfile) == 'function' and (pcall(readfile, filename))
end

function lib:saveConfig(name: string?)
	if type(writefile) ~= 'function' then return false end
	if type(makefolder) == 'function' then pcall(makefolder, 'Inertia') end

	local saved = {}
	for flag, value in pairs(self.flags) do
		if not self.unsaved[flag] then
			saved[flag] = serializeValue(value)
		end
	end

	local encoded, json = pcall(HttpService.JSONEncode, HttpService, saved)
	if not encoded then
		warn('[Inertia] config encode failed: ' .. tostring(json))
		return false
	end
	return (pcall(writefile, 'Inertia/' .. self:configName(name) .. '.json', json))
end

function lib:listConfigs()
	if type(listfiles) ~= 'function' then return {} end
	if type(makefolder) == 'function' then pcall(makefolder, 'Inertia') end
	local configs = {}
	for _, path in ipairs(listfiles('Inertia')) do
		local name = tostring(path):match('([^/\\]+)%.json$')
		if name then table.insert(configs, name) end
	end
	table.sort(configs)
	return configs
end

local function applyFlag(flag: string, value: any)
	local setter = lib.flagControls[flag]
	if not setter then
		return
	end
	local success, err = pcall(setter, value)
	if not success then
		warn(string.format('[Inertia] failed to apply %s: %s', flag, tostring(err)))
	end
end

-- Setters run with callbacks live, so a loaded config actually switches features on.
-- Flags whose element does not exist yet are parked in lib.pending and applied when it registers.
function lib:loadConfig(name: string?)
	local filename = 'Inertia/' .. self:configName(name) .. '.json'
	if type(readfile) ~= 'function' or not self:configExists(name) then return false end
	local success, data = pcall(function() return HttpService:JSONDecode(readfile(filename)) end)
	if not success or type(data) ~= 'table' then return false end

	self.loadingConfig = true
	for flag, value in pairs(data) do
		if not self.unsaved[flag] then
			local decoded = deserializeValue(value)
			if self.flagControls[flag] then
				applyFlag(flag, decoded)
			else
				self.pending[flag] = decoded
				self:setFlag(flag, decoded)
			end
		end
	end
	self.loadingConfig = false
	return true
end

function lib:resetConfig()
	for flag, value in pairs(self.defaults) do
		if not self.unsaved[flag] then
			applyFlag(flag, copyValue(value))
		end
	end
end

function lib:setAutoLoadConfig(name: string)
	if type(writefile) ~= 'function' or not self:configExists(name) then return false end
	if type(makefolder) == 'function' then pcall(makefolder, 'Inertia') end
	return (pcall(writefile, 'Inertia/autoload.txt', self:configName(name)))
end

function lib:clearAutoLoadConfig()
	if type(isfile) == 'function' and not isfile('Inertia/autoload.txt') then return true end
	if type(delfile) == 'function' then
		return (pcall(delfile, 'Inertia/autoload.txt'))
	end
	return type(writefile) == 'function' and (pcall(writefile, 'Inertia/autoload.txt', ''))
end

function lib:getAutoLoadConfig()
	if type(readfile) ~= 'function' or (type(isfile) == 'function' and not isfile('Inertia/autoload.txt')) then return nil end
	local success, name = pcall(readfile, 'Inertia/autoload.txt')
	if not success or type(name) ~= 'string' then return nil end
	name = name:gsub('^%s+', ''):gsub('%s+$', '')
	return name ~= '' and name or nil
end

function lib:loadAutoloadConfig()
	local name = self:getAutoLoadConfig()
	if not name then return false end
	return self:loadConfig(name), name
end

local function getFlagName(data)
	return data.flag or data.text
end

-- value is what the flag stores (and what a reset restores); it defaults to data.val.
-- save = false keeps the flag out of saved configs (e.g. lists of live player names).
local function bindFlag(flag: string?, setter: (any) -> (), value: any, save: boolean?)
	if not flag or flag == '' then
		return
	end

	lib.unsaved[flag] = save == false or nil
	lib.defaults[flag] = copyValue(value)
	lib.flagControls[flag] = setter

	local pending = lib.pending[flag]
	lib.pending[flag] = nil
	if pending ~= nil and save ~= false then
		applyFlag(flag, pending)
	else
		lib:setFlag(flag, value)
	end
end

local function registerFlag(data, setter, value)
	if value == nil then value = data.val end
	bindFlag(getFlagName(data), setter, value, data.save)
end

