function lib.elements:newslider(...)
	local data = lib:overwrite({
		text = 'browen';
		flag = nil;
		val = 0;
		min = 20;
		max = 100;
		prefix = '';
		suffix = '';
		call = print;
		axis = 'x';
	}, ... or {})

	local base = self:baee(...)

	local hitbox = new("TextButton", { Parent = base.c3; Name = "Sliderbutton"; TextTransparency = 1; AutoButtonColor = false; BackgroundColor3 = Color3.fromRGB(18, 18, 18); BorderColor3 = Color3.fromRGB(0, 0, 0); BorderSizePixel = 0; FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal); Size = UDim2.new(1, 0, 0, 6); TextColor3 = Color3.fromRGB(0, 0, 0); TextSize = 14; }) :: TextButton 
	local fill = new("Frame", { Parent = hitbox; Name = "Fill"; BackgroundColor3 = lib.theme.accent; BorderColor3 = Color3.fromRGB(0, 0, 0); BorderSizePixel = 0; Size = UDim2.fromScale(0.5, 1); }) 
	new("UIStroke", { Parent = hitbox; ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) 
	local val = new("TextLabel", { Parent = base.c2; Name = "Value"; BackgroundTransparency = 1; FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal); Size = UDim2.fromOffset(44, 8); Text = ""; TextColor3 = lib.theme.t2; TextSize = 11; TextTruncate = Enum.TextTruncate.AtEnd; TextXAlignment = Enum.TextXAlignment.Right; TextYAlignment = Enum.TextYAlignment.Center; LayoutOrder = 1; }) :: TextLabel

	local mouse = game.Players.LocalPlayer:GetMouse();
	local down = nil;

	local function formatValue(value)
		local rounded = math.floor(value * 100 + 0.5) / 100
		if rounded == math.floor(rounded) then
			return tostring(math.floor(rounded))
		end
		return string.format("%.2f", rounded):gsub("0+$", ""):gsub("%.$", "")
	end

	local function ie(Input : InputObject, GPE)
		if Input.UserInputState == Enum.UserInputState.End then
			-- Only letting go of the mouse ends a drag; releasing W mid-drag used to drop it.
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				down = nil
			end
			return
		end
		down = (down and (down) or hitbox.GuiState == Enum.GuiState.Press)

		if down and lib:validinput(Input) then
			local minb = hitbox.AbsolutePosition
			local maxb = (minb + hitbox.AbsoluteSize);
			local clamp = Vector2.new(math.clamp(mouse.X, minb.X, maxb.X),math.clamp(mouse.Y, minb.Y, maxb.Y))
			local rel = ((clamp - minb) / hitbox.AbsoluteSize)
			local frac = (data.axis == 'x') and rel.X or rel.Y
			local value = data.min + (data.max - data.min) * frac
			value = math.clamp(value, data.min, data.max)
			data:set(value)
		end
	end

	function data:set(v)
		data.val = v;
		lib:setFlag(getFlagName(data), v)

		val.Text = `{data.prefix}{formatValue(data.val)}{data.suffix}`

		fill.Size = UDim2.fromScale(
			data.axis == 'x' and ((data.val - data.min) / (data.max - data.min)) or 1,
			data.axis == 'x' and 1 or ((data.val - data.min) / (data.max - data.min))
		)
		data.call(v)
	end

	lib:connect(UserInputService.InputBegan, ie);
	lib:connect(UserInputService.InputEnded, ie);
	lib:connect(UserInputService.InputChanged, ie);
	data:set(data.val)
	registerFlag(data, function(value)
		if type(value) == 'number' then
			data:set(math.clamp(value, data.min, data.max))
		end
	end)

	return data
end

