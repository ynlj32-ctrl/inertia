	-- The picker's own HSV state. The markers tween, so reading them back mid-tween (as the old
	-- code did) made the colour jump back whenever a second bar was touched.
	local Hue, Saturation, Brightness = 0, 0, 1

	local function RepositionColorPicker()
		ColorPickerFrame.Position = UDim2.fromOffset(
			ElementButton.AbsolutePosition.X + 2,
			ElementButton.AbsolutePosition.Y + (ElementButton.AbsoluteSize.Y) + 8
		)
	end

	-- Accepts "r, g, b[, alpha]" (0-255) or a hex string.
	local function StringToColor(String : string): (Color3?, number?)
		local ColorData = String:split(',')
		if #ColorData >= 3 then
			local r, g, b = tonumber(ColorData[1]), tonumber(ColorData[2]), tonumber(ColorData[3])
			if r and g and b then
				return Color3.fromRGB(r, g, b), tonumber(ColorData[4])
			end
			return nil, nil
		end
		local success, color = pcall(Color3.fromHex, String)
		return success and color or nil, nil
	end

	local function Relative(frame: GuiObject): (number, number)
		local AbsPos, AbsSize = frame.AbsolutePosition, frame.AbsoluteSize
		return math.clamp((Mouse.X - AbsPos.X) / AbsSize.X, 0, 1), math.clamp((Mouse.Y - AbsPos.Y) / AbsSize.Y, 0, 1)
	end

	local function Slide(marker: GuiObject, x: number, y: number)
		TweenService:Create(marker, TweenInfo.new(.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Position = UDim2.fromScale(x, y),
			AnchorPoint = Vector2.new(x, y),
		}):Play()
	end

	local function PaintHue()
		SaturationGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 0, 1));
			ColorSequenceKeypoint.new(1, Color3.fromHSV(Hue, 1, 1));
		})
	end

	local function UpdateColor(Color: Color3, Alpha: number?)
		ElementData.val = Color
		ElementData.alpha = math.clamp(Alpha or ElementData.alpha or 1, 0, 1)
		lib:setFlag(getFlagName(ElementData), {value = ElementData.val; alpha = ElementData.alpha;})

		ElementButton.BackgroundColor3 = ElementData.val
		ElementButton.BackgroundTransparency = (1-ElementData.alpha)
		AlphaFill.BackgroundColor3 = ElementData.val

		ElementData.call(ElementData.val, ElementData.alpha)
	end

	local function UpdateMarkers()
		ColorMarker.Position = UDim2.fromScale(Saturation, 1 - Brightness)
		ColorMarker.AnchorPoint = Vector2.new(Saturation, 1 - Brightness)
		HueMarker.Position = UDim2.fromScale(0.5, Hue)
		HueMarker.AnchorPoint = Vector2.new(0.5, Hue)
		AlphaMarker.Position = UDim2.fromScale(ElementData.alpha, 0.5)
		AlphaMarker.AnchorPoint = Vector2.new(ElementData.alpha, 0.5)
		PaintHue()
	end

	local function UpdateColorMap()
		local x, y = Relative(ColorMap)
		Slide(ColorMarker, x, y)
		Saturation, Brightness = x, 1 - y
		UpdateColor(Color3.fromHSV(Hue, Saturation, Brightness), ElementData.alpha)
	end

	local function UpdateHueBar()
		local _, y = Relative(HueBar)
		Slide(HueMarker, 0.5, y)
		Hue = y
		PaintHue()
		UpdateColor(Color3.fromHSV(Hue, Saturation, Brightness), ElementData.alpha)
	end

	local function UpdateAlphaBar()
		local x = Relative(AlphaBar)
		Slide(AlphaMarker, x, 0.5)
		UpdateColor(ElementData.val, x)
	end

	-- Takes a Color3 (+ alpha), a saved {value, alpha} table, or a "r, g, b[, a]" / hex string.
	-- A missing alpha keeps the current one instead of turning the colour invisible.
	function ElementData:Set(NewValue : any?, Alpha : number?)
		if type(NewValue) == 'table' then
			NewValue, Alpha = NewValue.value, NewValue.alpha
		end
		if typeof(NewValue) == 'string' then
			local Parsed, ParsedAlpha = StringToColor(NewValue)
			NewValue, Alpha = Parsed, ParsedAlpha or Alpha
		end
		if typeof(NewValue) ~= 'Color3' then
			return
		end

		local h, s, v = NewValue:ToHSV()
		if s > 0 and v > 0 then
			Hue = h -- greys carry no hue; keep the bar where it was
		end
		Saturation, Brightness = s, v

		UpdateColor(NewValue, Alpha)
		UpdateMarkers()
	end

	ElementButton:GetPropertyChangedSignal('AbsolutePosition'):Connect(RepositionColorPicker)

	lib:addPopup(ColorPickerFrame, function()
		ElementData.Dropped = false
		Editing = false
	end)

	ElementButton.Activated:Connect(function()
		local open = not ColorPickerFrame.Visible
		if open then
			lib:closePopups(ColorPickerFrame)
		end
		ColorPickerFrame.Visible = open
		ElementData.Dropped = open

		RepositionColorPicker()
	end)

	local Editors = {
		ColorMap = UpdateColorMap;
		AlphaBar = UpdateAlphaBar;
		HueBar = UpdateHueBar;
	}

	lib:connect(UserInputService.InputBegan, function(Input)
		if not ColorPickerFrame.Visible then
			return
		end
		if ((Input.UserInputType ==Enum.UserInputType.MouseButton1) or (Input.UserInputType ==Enum.UserInputType.Touch)) then
			if AlphaBar.GuiState ==Enum.GuiState.Press then
				Editing = "AlphaBar"
				UpdateAlphaBar()
			end

			if HueBar.GuiState ==Enum.GuiState.Press then
				Editing = "HueBar"
				UpdateHueBar()
			end

			if ColorMap.GuiState ==Enum.GuiState.Press then
				Editing = 'ColorMap'
				UpdateColorMap()
			end
		end
	end)

	lib:connect(UserInputService.InputEnded, function(Input)
		if ((Input.UserInputType ==Enum.UserInputType.MouseButton1) or (Input.UserInputType ==Enum.UserInputType.Touch)) then
			Editing = false;
		end
	end)

	lib:connect(UserInputService.InputChanged, function(Input)
		if Input.UserInputType ==Enum.UserInputType.MouseMovement and Editing then
			Editors[Editing]();
		end
	end)

	lib:connect(UserInputService.TouchMoved, function(Input)
		if Input.UserInputType ==Enum.UserInputType.Touch and Editing then
			Editors[Editing]();
		end
	end)

	ElementData:Set(ElementData.val, ElementData.alpha)
	RepositionColorPicker();
	registerFlag(ElementData, function(value)
		ElementData:Set(value)
	end, {value = ElementData.val; alpha = ElementData.alpha;})

	return ElementData
end

