		Name = "Keybind";
		LayoutOrder = #lib.overlays.keybindItems + 1;
		Size = UDim2.new(1, 0, 0, 16);
		Text = string.format("%s  [%s]", label, tostring(defaultKey or data.val or '?'));
		TextXAlignment = Enum.TextXAlignment.Left;
		ZIndex = 101;
	})
	table.insert(lib.overlays.keybindItems, {data = data; item = item; label = label;})
	local function refresh()
		local mode = data.mode ~= 'Click' and data.mode and ('  ' .. string.lower(data.mode)) or ''
		item.Text = string.format("%s  [%s]%s", label, tostring(data.val or '?'), mode)
		item.TextColor3 = data.active and lib.theme.accent or lib.theme.t2
	end
	data._refreshKeybind = refresh
	refresh()
	return item
end

