local function SaveConfig()
	local save = {}
	for key, toggle in pairs(Toggles) do
		if typeof(toggle.Value) == "boolean" then
			save[key] = toggle.Value
		end
	end
	for key, option in pairs(Options) do
		local v = option.Value
		if typeof(v) == "Color3" then
			save[key] = {R = math.floor(v.R * 255), G = math.floor(v.G * 255), B = math.floor(v.B * 255)}
		elseif typeof(v) == "number" or typeof(v) == "string" then
			save[key] = v
		end
	end
	if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
	writefile(CONFIG_FILE, HttpService:JSONEncode(save))
end

local function LoadConfigUI()
	if not isfile(CONFIG_FILE) then return end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(CONFIG_FILE))
	end)
	if not ok or type(data) ~= "table" then return end
	for k, v in pairs(data) do
		if type(v) == "table" and v.R and v.G and v.B then
			v = Color3.fromRGB(v.R, v.G, v.B)
		end
		if Toggles[k] and typeof(v) == "boolean" then
			Toggles[k]:SetValue(v)
		elseif Options[k] then
			Options[k]:SetValue(v)
		end
	end
end

