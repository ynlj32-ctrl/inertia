-- Skin Functions

local OriginalParts = {}

local function ClearSkinModel(model)
	for _, desc in model:GetDescendants() do
		if desc.Name == "_SKIN_" then desc:Destroy() end
	end
	local h = model:FindFirstChildOfClass("Highlight")
	if h then h:Destroy() end
	for part, orig in pairs(OriginalParts) do
		if part:IsDescendantOf(model) and part.Parent then
			part.Material = orig.Material
			part.Color = orig.Color
			part.Reflectance = orig.Reflectance
			part.Transparency = orig.Transparency
			if part:IsA("MeshPart") then part.TextureID = orig.TextureID end
			OriginalParts[part] = nil
		end
	end
end

local function AnimateSkin(data, tool)
	task.spawn(function()
		local textures = {}
		for _, desc in tool:GetDescendants() do
			if desc.Name == "_SKIN_" and desc:IsA("Texture") then
				table.insert(textures, desc)
			end
		end
		if #textures == 0 then return end

		local t = 0
		local frame = 1

		while tool.Parent and Toggles.SkinChanger and Toggles.SkinChanger.Value do
			for i = #textures, 1, -1 do
				if not textures[i].Parent then table.remove(textures, i) end
			end
			if #textures == 0 then return end

			if data.Type == "MovingTexture" then
				for _, tex in textures do tex.OffsetStudsV = tex.OffsetStudsV + data.Speed end
			elseif data.Type == "ShakingTexture" then
				for _, tex in textures do
					tex.OffsetStudsU = (math.random() - 0.5) * data.Speed * 2
					tex.OffsetStudsV = (math.random() - 0.5) * data.Speed * 2
				end
			elseif data.Type == "PulsatingTexture" then
				t = t + 0.05
				for _, tex in textures do tex.Rotation = (tex.Rotation + 0.25) % 360 end
			elseif data.Type == "GIFTexture" then
				t = t + 0.05
				if data.Speed <= t then
					frame = frame + 1
					if frame > #data.AssetId then frame = 1 end
					t = 0
					for _, tex in textures do tex.Texture = data.AssetId[frame] end
				end
			end

			task.wait(0.05)
		end
	end)
end

local function SkinModel(model, data)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.Transparency < 0.5 then
			if data.Type == "Material" then
				OriginalParts[part] = {
					Material = part.Material,
					Color = part.Color,
					Reflectance = part.Reflectance,
					Transparency = part.Transparency,
					TextureID = part:IsA("MeshPart") and part.TextureID or nil,
				}
				if part:IsA("MeshPart") then part.TextureID = "" end
				part.Material = data.AssetId
				part.Reflectance = data.Reflectance or 0
				part.Transparency = data.Transparency or 0
				part.Color = data.Color3
			else
				local className = data.Type == "Decal" and "Decal" or "Texture"
				for _, face in Enum.NormalId:GetEnumItems() do
					local obj = Instance.new(className)
					obj.Face = face
					obj.Texture = type(data.AssetId) == "table" and data.AssetId[1] or data.AssetId
					obj.Color3 = data.Color3
					obj.Name = "_SKIN_"
					if className == "Texture" then
						obj.StudsPerTileU = data.StudsPerTileU or 1
						obj.StudsPerTileV = data.StudsPerTileV or 1
					end
					obj.Parent = part
				end
			end
		end
	end

	if data.Highlight then
		local h = Instance.new("Highlight")
		h.FillTransparency = 1
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.OutlineColor = data.Highlight.OutlineColor
		h.OutlineTransparency = data.Highlight.OutlineTransparency
		h.Parent = model
	end

	if data.Type == "MovingTexture" or data.Type == "ShakingTexture" or data.Type == "PulsatingTexture" or data.Type == "GIFTexture" then
		AnimateSkin(data, model)
	end
end

local function GetViewmodel(tool)
	local ok, gun = pcall(function()
		return ViewmodelHandler:GetVisualGun(tool)
	end)
	if ok and gun and gun ~= tool then return gun end
	return nil
end

local function ApplySkin()
	if not Character then return end
	local tool = Character:FindFirstChildOfClass("Tool")
	if not tool then return end

	ClearSkinModel(tool)
	local viewmodel = GetViewmodel(tool)
	if viewmodel then ClearSkinModel(viewmodel) end

	if not Toggles.SkinChanger.Value or Options.SelectedSkin.Value == "Default" then return end

	local data = SkinData[Options.SelectedSkin.Value]
	if not data then return end

	SkinModel(tool, data)
	if viewmodel then SkinModel(viewmodel, data) end
end

