RunService.RenderStepped:Connect(function()
	local mouse = UserInputService:GetMouseLocation()
	FOVCircle.Visible = Config.ShowFOV
	FOVCircle.Radius = Config.FOVRadius
	FOVCircle.Color = Config.FOVColor
	FOVCircle.Position = mouse
	FOVCircleOutline.Visible = Config.ShowFOV
	FOVCircleOutline.Radius = Config.FOVRadius
	FOVCircleOutline.Position = mouse

	if Config.AimbotEnabled and Config.AimbotMode == "Camera" and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local camera = GetCamera()
		local _, targetPos = GetTarget(camera.CFrame.Position)
		if targetPos then
			local screenPos = camera:WorldToViewportPoint(targetPos)
			local center = camera.ViewportSize / 2
			local deltaX = (screenPos.X - center.X) / Config.Smoothing
			local deltaY = (screenPos.Y - center.Y) / Config.Smoothing
			mousemoverel(deltaX, deltaY)
		end
	end
end)

