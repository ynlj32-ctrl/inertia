-- Target Finder

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function GetTarget(origin)
	local Mouse = UserInputService:GetMouseLocation()

	local bestDistance = math.huge
	local bestDirection = nil
	local bestPosition = nil

	for _, player in Players:GetPlayers() do
		if player == LocalPlayer then continue end
		if Toggles.TeamCheck.Value and player.Team == LocalPlayer.Team then continue end

		local character = player.Character
		if not character then continue end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end

		local partName = Options.HitPart.Value
		local part = character:FindFirstChild(partName) or character:FindFirstChild("Head")
		if not part then continue end

		local screenPos, onScreen = GetCamera():WorldToViewportPoint(part.Position)
		if not onScreen then continue end

		if Toggles.VisibleCheck.Value then
			RayParams.FilterDescendantsInstances = {LocalPlayer.Character}
			local ray = workspace:Raycast(origin, part.Position - origin, RayParams)
			if ray and not ray.Instance:IsDescendantOf(character) then continue end
		end

		local screenVec = Vector2.new(screenPos.X, screenPos.Y)
		local dist = (screenVec - Mouse).Magnitude
		if dist <= Options.FOVRadius.Value and dist < bestDistance then
			bestDistance = dist
			bestDirection = (part.Position - origin).Unit
			bestPosition = part.Position
		end
	end

	return bestDirection, bestPosition
end

-- Hooks

local oldRecoil = Weapon_Module.recoil
Weapon_Module.recoil = function(...)
	if Toggles.NoRecoil.Value then return end
	return oldRecoil(...)
end

local function UpdateHooks()
	if not FirearmLocal then return end

	local originalAim = FirearmLocal.GetAimDirection
	FirearmLocal.GetAimDirection = function(...)
		if Toggles.NoSpread.Value then
			return originalAim(0)
		end
		return originalAim(...)
	end

	local originalDir = FirearmLocal.GetDirection
	FirearmLocal.GetDirection = function(...)
		local direction, origin = originalDir(...)

		if Toggles.AimbotEnabled.Value and Options.AimbotMode.Value == "Silent" then
			local newDirection = GetTarget(origin)
			if newDirection then
				direction = newDirection
			end
		end

		return direction, origin
	end
end

UpdateHooks()

if not FirearmLocal then
	task.spawn(function()
		while not FirearmLocal do
			local env = WaitForEnv(Character)
			if env then
				FirearmLocal = env
				UpdateHooks()
			end
			task.wait(2)
		end
	end)
end

-- ESP

local Paint = DrawingImmediate.GetPaint(1)

Paint:Connect(function()
	if not (Toggles.ESPBox.Value or Toggles.ESPName.Value or Toggles.ESPWeapon.Value or Toggles.ESPHealthBar.Value) then return end

	local camera = GetCamera()

	for _, player in Players:GetPlayers() do
		if player == LocalPlayer then continue end
		if Toggles.TeamCheck.Value and player.Team == LocalPlayer.Team then continue end

		local character = player.Character
		if not character then continue end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end

		local cf, bSize = character:GetBoundingBox()
		local half = bSize / 2

		local minX, minY = math.huge, math.huge
		local maxX, maxY = -math.huge, -math.huge
		local visible = false

		for _, offset in {
			Vector3.new(half.X, half.Y, half.Z),
			Vector3.new(-half.X, half.Y, half.Z),
			Vector3.new(half.X, -half.Y, half.Z),
			Vector3.new(-half.X, -half.Y, half.Z),
			Vector3.new(half.X, half.Y, -half.Z),
			Vector3.new(-half.X, half.Y, -half.Z),
			Vector3.new(half.X, -half.Y, -half.Z),
			Vector3.new(-half.X, -half.Y, -half.Z),
		} do
			local sp, onScreen = camera:WorldToViewportPoint((cf * CFrame.new(offset)).Position)
			if onScreen then
				visible = true
				if sp.X < minX then minX = sp.X end
				if sp.X > maxX then maxX = sp.X end
				if sp.Y < minY then minY = sp.Y end
				if sp.Y > maxY then maxY = sp.Y end
			end
		end

		if not visible then continue end

		local topLeft = Vector2.new(minX, minY)
		local size = Vector2.new(maxX - minX, maxY - minY)
		local centerX = (minX + maxX) / 2

		if Toggles.ESPBox.Value then
			DrawingImmediate.Rectangle(
				Vector2.new(topLeft.X - 1, topLeft.Y - 1),
				Vector2.new(size.X + 2, size.Y + 2),
				Color3.new(0, 0, 0), 1, 0, 1
			)
			DrawingImmediate.Rectangle(
				Vector2.new(topLeft.X + 1, topLeft.Y + 1),
				Vector2.new(size.X - 2, size.Y - 2),
				Color3.new(0, 0, 0), 1, 0, 1
			)
			DrawingImmediate.Rectangle(topLeft, size, Options.ESPBoxColor.Value, 1, 0, 1)
		end

		if Toggles.ESPName.Value then
			DrawingImmediate.OutlinedText(
				Vector2.new(centerX, minY - 16),
				0, 13,
				Options.ESPNameColor.Value, 1,
				Color3.new(0, 0, 0), 1,
				player.DisplayName, true
			)
		end

		if Toggles.ESPWeapon.Value then
			local tool = character:FindFirstChildOfClass("Tool")
			local weaponName = tool and tool.Name or "None"
			DrawingImmediate.OutlinedText(
				Vector2.new(centerX, maxY + 2),
				0, 13,
				Options.ESPWeaponColor.Value, 1,
				Color3.new(0, 0, 0), 1,
				weaponName, true
			)
		end

		if Toggles.ESPHealthBar.Value then
			local healthFrac = humanoid.Health / humanoid.MaxHealth
			local height = size.Y
			local barWidth = 3
			local barX = topLeft.X - barWidth - 2

			DrawingImmediate.FilledRectangle(
				Vector2.new(barX, minY),
				Vector2.new(barWidth, height),
				Color3.new(0, 0, 0), 0.5, 0
			)

			local fillHeight = height * healthFrac
			local healthColor = Color3.fromRGB(255 * (1 - healthFrac), 255 * healthFrac, 0)
			DrawingImmediate.FilledRectangle(
				Vector2.new(barX, minY + (height - fillHeight)),
				Vector2.new(barWidth, fillHeight),
				healthColor, 1, 0
			)

			DrawingImmediate.Rectangle(
				Vector2.new(barX, minY),
				Vector2.new(barWidth, height),
				Color3.new(0, 0, 0), 1, 0, 1
			)
		end
	end
end)

-- Render Loop

local lastConfigSave = os.clock()

RunService.RenderStepped:Connect(function()
	if os.clock() - lastConfigSave > 5 then
		lastConfigSave = os.clock()
		SaveConfig()
	end

	local mouse = UserInputService:GetMouseLocation()
	FOVCircle.Visible = Toggles.ShowFOV.Value
	FOVCircle.Radius = Options.FOVRadius.Value
	FOVCircle.Color = Options.FOVColor.Value
	FOVCircle.Position = mouse
	FOVCircleOutline.Visible = Toggles.ShowFOV.Value
	FOVCircleOutline.Radius = Options.FOVRadius.Value
	FOVCircleOutline.Position = mouse

	if Toggles.AimbotEnabled.Value and Options.AimbotMode.Value == "Camera" and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local camera = GetCamera()
		local _, targetPos = GetTarget(camera.CFrame.Position)
		if targetPos then
			local screenPos = camera:WorldToViewportPoint(targetPos)
			local center = camera.ViewportSize / 2
			local deltaX = (screenPos.X - center.X) / Options.Smoothing.Value
			local deltaY = (screenPos.Y - center.Y) / Options.Smoothing.Value
			mousemoverel(deltaX, deltaY)
		end
	end
end)

-- Respawn Handler

local function WatchWeapons(char)
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and Toggles.SkinChanger.Value then
			task.wait(0.1)
			ApplySkin()
		end
	end)
end

WatchWeapons(Character)

LocalPlayer.CharacterAdded:Connect(function(char)
	Character = char
	char:WaitForChild("Humanoid")
	task.wait(1)
	local env = WaitForEnv(char)
	if env then
		FirearmLocal = env
		UpdateHooks()
	end
	WatchWeapons(char)
end)

-- Teleport Persistence

local SCRIPT_URL = "https://raw.githubusercontent.com/ynlj32-ctrl/inertia/refs/heads/main/hood-rivals"

do
	local scriptSource
	local ok, info = pcall(function()
		return debug.getinfo(1, "s").source
	end)

	if ok and info and type(info) == "string" then
		if info:sub(1, 1) == "@" then
			local path = info:sub(2)
			if isfile(path) then
				local rok, src = pcall(readfile, path)
				if rok then scriptSource = src end
			end
		elseif info:sub(1, 1) == "=" then
			scriptSource = info:sub(2)
		else
			scriptSource = info
		end
	end

	if scriptSource and #scriptSource > 0 and writefile then
		pcall(writefile, SCRIPT_FILE, scriptSource)
	end

	pcall(function()
		queueonteleport(([[
			repeat task.wait() until game:IsLoaded()
			local SCRIPT_URL = %q
			local SCRIPT_FILE = %q

			local function fetchSource()
				local ok, body = pcall(function()
					return game:HttpGet(SCRIPT_URL .. "?v=" .. tostring(tick()), true)
				end)
				if ok and type(body) == "string" and #body > 0 then
					if writefile then
						pcall(writefile, SCRIPT_FILE, body)
					end
					return body
				end
				if isfile(SCRIPT_FILE) then
					local rok, src = pcall(readfile, SCRIPT_FILE)
					if rok then return src end
				end
				return nil
			end

			local src = fetchSource()
			if not src then
				warn("[Inertia] teleport reload: no source available")
				return
			end

			local fn, compileErr = loadstring(src)
			if not fn then
				warn("[Inertia] teleport reload compile error: " .. tostring(compileErr))
				return
			end

			local ok, err = pcall(fn)
			if not ok then
				warn("[Inertia] teleport reload runtime error: " .. tostring(err))
			end
		]]):format(SCRIPT_URL, SCRIPT_FILE))
	end)
end
