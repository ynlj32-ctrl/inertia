local function WaitForEnv(char)
	local script = char:WaitForChild("FirearmLocal", 15)
	if not script then return nil end
	for _ = 1, 20 do
		local ok, env = pcall(getsenv, script)
		if ok and env and env.GetDirection then return env end
		task.wait(0.5)
	end
	return nil
end

